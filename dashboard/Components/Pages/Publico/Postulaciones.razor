@page "/postulaciones"
@page "/postulaciones/{SolicitudId:int}"
@layout dashboard.Components.Layout.PublicoLayout
@rendermode InteractiveServer
@using dashboard.Data
@inject PostulacionPublicaService PostulacionPublicaService
@inject NavigationManager NavigationManager

<PageTitle>Trabaja con nosotros | SOS Group</PageTitle>

<h1>Búsquedas abiertas</h1>
<p class="pub-intro">Postula directamente a las oportunidades activas — <b>no necesitas crear una cuenta.</b></p>

@if (solicitudes is null)
{
    <p>Cargando…</p>
}
else if (solicitudes.Count == 0)
{
    <div class="pub-empty-state">Por el momento no hay búsquedas abiertas. Vuelve a revisar más adelante.</div>
}
else
{
    <div class="pub-search">
        <input type="text" placeholder="Buscar por cargo, empresa o ubicación…" value="@filtro" @oninput="@(e => filtro = e.Value?.ToString() ?? string.Empty)" />
    </div>

    <div class="pub-split @(SolicitudId is not null ? "showing-detail" : "")">
        <div class="pub-list">
            <a class="link-btn pub-back" href="/postulaciones">&larr; Volver a la lista</a>
            <p class="pub-list-count">@solicitudesFiltradas.Count ofertas</p>

            @foreach (var s in solicitudesFiltradas)
            {
                <button type="button" class="pub-job-card @(s.Id == solicitudIdActual ? "selected" : "")" @onclick="() => Seleccionar(s.Id)">
                    <p class="pub-job-title">@s.CargoNombre</p>
                    <p class="pub-job-meta">@s.ClienteRazonSocial</p>
                    @if (!string.IsNullOrWhiteSpace(s.DireccionServicio))
                    {
                        <p class="pub-job-meta">@s.DireccionServicio</p>
                    }
                    <p class="pub-job-time">Inicio: @s.FechaInicioServicio.ToString("dd-MM-yyyy")</p>
                </button>
            }

            @if (solicitudesFiltradas.Count == 0)
            {
                <div class="pub-empty-state">No encontramos resultados para "@filtro".</div>
            }
        </div>

        @if (solicitudIdActual is not null)
        {
            <SolicitudPublicaPanel SolicitudId="solicitudIdActual.Value" />
        }
        else
        {
            <div class="pub-detail-panel"><div class="pub-empty-state">Selecciona una búsqueda de la lista para ver el detalle.</div></div>
        }
    </div>
}

@code {
    [Parameter]
    public int? SolicitudId { get; set; }

    private List<PostulacionPublicaService.SolicitudPublicaResumen>? solicitudes;
    private string filtro = string.Empty;
    private int? solicitudIdActual;

    private List<PostulacionPublicaService.SolicitudPublicaResumen> solicitudesFiltradas =>
        solicitudes is null
            ? []
            : string.IsNullOrWhiteSpace(filtro)
                ? solicitudes
                : solicitudes.Where(s =>
                    s.CargoNombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    s.ClienteRazonSocial.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (s.DireccionServicio?.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false))
                  .ToList();

    protected override async Task OnInitializedAsync()
    {
        solicitudes = await PostulacionPublicaService.ListarSolicitudesAbiertasAsync();
    }

    // Si la ruta trae un Id (link directo compartido), esa es la selección; si no, se selecciona
    // la primera de la lista automáticamente — igual que en la referencia de Computrabajo.
    protected override void OnParametersSet()
    {
        solicitudIdActual = SolicitudId ?? solicitudes?.FirstOrDefault()?.Id;
    }

    private void Seleccionar(int id)
    {
        solicitudIdActual = id;
        NavigationManager.NavigateTo($"/postulaciones/{id}", replace: true);
    }
}

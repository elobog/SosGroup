@page "/postulaciones/{SolicitudId:int}"
@layout dashboard.Components.Layout.PublicoLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using dashboard.Data
@inject PostulacionPublicaService PostulacionPublicaService
@inject NavigationManager NavigationManager

<PageTitle>@(detalle?.CargoNombre ?? "Postulación") | SOS Group</PageTitle>

<a class="link-btn public-back" href="/postulaciones">&larr; Volver a búsquedas abiertas</a>

@if (detalle is null)
{
    <p>Esta búsqueda ya no está disponible.</p>
}
else
{
    <div class="panel">
        <div class="panel-head">
            <h3>@detalle.CargoNombre</h3>
            <span class="tag">@detalle.ClienteRazonSocial</span>
        </div>
        <div class="detail-grid">
            @if (!string.IsNullOrWhiteSpace(detalle.DireccionServicio))
            {
                <div><span class="detail-lbl">Lugar</span>@detalle.DireccionServicio</div>
            }
            <div><span class="detail-lbl">Fecha de inicio</span>@detalle.FechaInicioServicio.ToString("dd-MM-yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(detalle.EducacionMinima))
            {
                <div><span class="detail-lbl">Educación mínima</span>@detalle.EducacionMinima</div>
            }
            @if (detalle.AniosExperienciaMinimo is not null)
            {
                <div><span class="detail-lbl">Experiencia mínima</span>@detalle.AniosExperienciaMinimo años</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(detalle.Descripcion))
        {
            <div style="padding:0 20px 18px;"><span class="detail-lbl">Descripción</span><p style="margin:4px 0 0;">@detalle.Descripcion</p></div>
        }
        @if (!string.IsNullOrWhiteSpace(detalle.ObjetivoCargo))
        {
            <div style="padding:0 20px 18px;"><span class="detail-lbl">Objetivo del cargo</span><p style="margin:4px 0 0;">@detalle.ObjetivoCargo</p></div>
        }
        @if (!string.IsNullOrWhiteSpace(detalle.Requisitos))
        {
            <div style="padding:0 20px 18px;"><span class="detail-lbl">Requisitos</span><p style="margin:4px 0 0;">@detalle.Requisitos</p></div>
        }
        @if (!string.IsNullOrWhiteSpace(detalle.ConocimientosTecnicos))
        {
            <div style="padding:0 20px 18px;"><span class="detail-lbl">Conocimientos técnicos</span><p style="margin:4px 0 0;">@detalle.ConocimientosTecnicos</p></div>
        }
        @if (!string.IsNullOrWhiteSpace(detalle.CondicionesEspeciales))
        {
            <div style="padding:0 20px 18px;"><span class="detail-lbl">Condiciones especiales</span><p style="margin:4px 0 0;">@detalle.CondicionesEspeciales</p></div>
        }
    </div>

    <div class="panel">
        <div class="panel-head"><h3>Postular a este cargo</h3></div>

        @if (enviado)
        {
            <div style="padding:20px;">
                <p><b>¡Listo!</b> Te enviamos un correo a <b>@form.Correo</b> para confirmar tu postulación. Revisa tu bandeja de entrada (y spam) y sigue el link para continuar.</p>
            </div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="EnviarAsync" class="form-grid">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label>Nombre completo</label>
                    <InputText @bind-Value="form.Nombre" />
                    <ValidationMessage For="() => form.Nombre" class="text-danger" />
                </div>
                <div class="form-field">
                    <label>Correo</label>
                    <InputText @bind-Value="form.Correo" />
                    <ValidationMessage For="() => form.Correo" class="text-danger" />
                </div>
                <div class="form-field">
                    <label>Teléfono</label>
                    <InputText @bind-Value="form.Telefono" />
                    <ValidationMessage For="() => form.Telefono" class="text-danger" />
                </div>
                <div class="form-actions" style="grid-column:1/-1;">
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <span class="text-danger">@error</span>
                    }
                    <button type="submit" class="btn-primary" disabled="@enviando">Postular</button>
                </div>
            </EditForm>
        }
    </div>
}

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private PostulacionPublicaService.SolicitudPublicaDetalle? detalle;
    private FormModel form = new();
    private bool enviando;
    private bool enviado;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        detalle = await PostulacionPublicaService.ObtenerSolicitudPublicaAsync(SolicitudId);
    }

    private async Task EnviarAsync()
    {
        enviando = true;
        error = null;
        try
        {
            await PostulacionPublicaService.IniciarPostulacionAsync(SolicitudId, form.Nombre, form.Correo, form.Telefono, NavigationManager.BaseUri);
            enviado = true;
        }
        catch (Exception)
        {
            error = "No pudimos procesar tu postulación. Intenta nuevamente en unos minutos.";
        }
        finally
        {
            enviando = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Ingresa tu nombre.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu correo.")]
        [EmailAddress(ErrorMessage = "Correo inválido.")]
        public string Correo { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu teléfono.")]
        public string Telefono { get; set; } = "";
    }
}

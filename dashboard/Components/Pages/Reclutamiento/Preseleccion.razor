@page "/Reclutamiento/Preseleccion"
@page "/Reclutamiento/Preseleccion/{SolicitudId:int}"
@layout dashboard.Components.Layout.AppShellLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SuperAdmin,Admin,Supervisor Operaciones,Supervisor Administrativo,Reclutador")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using dashboard.Data
@using SolicitudModel = dashboard.Models.Reclutamiento.Solicitud

@inject SolicitudService SolicitudService
@inject PerfilCargoService PerfilCargoService
@inject AccesoAppService AccesoService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Preselección | SOS Group</PageTitle>

<div class="page-head">
    <div>
        <div class="breadcrumb"><b>Reclutamiento</b> / Preselección</div>
        <h1>@(SolicitudId is null ? "Preselección" : solicitudActual?.CodigoSolicitud ?? "Candidatos")</h1>
    </div>
</div>

<PreseleccionModuloTabs Activo="Candidatos" SolicitudId="SolicitudId" />

@if (SolicitudId is null)
{
    <div class="panel">
        <div class="panel-head"><h3>Solicitudes</h3><span class="tag">@solicitudes.Count</span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Código</th><th>Cliente</th><th>Perfil de cargo</th><th>Postulantes inscritos</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var s in solicitudes)
                    {
                        <tr>
                            <td><button class="row-code @(s.Estado == "Activa" ? "ok" : "")" @onclick="() => AbrirCandidatos(s.Id)">@s.CodigoSolicitud</button></td>
                            <td>@s.ClienteRazonSocial</td>
                            <td>@s.PerfilCargoNombre</td>
                            <td>@s.PostulantesCount</td>
                            <td>@if (s.Estado == "Activa") { <span class="pill ok">Activa</span> } else { <span class="pill pending">Cerrada</span> }</td>
                        </tr>
                    }
                    @if (solicitudes.Count == 0)
                    {
                        <tr><td colspan="5" style="color:var(--ink-faint);">Sin solicitudes registradas todavía.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (solicitudActual is not null)
{
    <div class="panel">
        <div class="panel-head">
            <h3>Candidatos — @perfilNombre</h3>
            <span class="tag">@postulantes.Count</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th><input type="checkbox" checked="@todosSeleccionados" @onchange="ToggleTodos" /></th>
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Fecha</th>
                        <th>Documentos</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in postulantes)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       checked="@(p.SeleccionadoPreseleccion || seleccionados.Contains(p.PostulanteSolicitudId))"
                                       disabled="@p.SeleccionadoPreseleccion"
                                       @onchange="e => ToggleUno(p.PostulanteSolicitudId, (bool)e.Value!)" />
                            </td>
                            <td>@p.Nombre</td>
                            <td>@p.RUT</td>
                            <td>@(p.Correo ?? "—")</td>
                            <td>@(p.Telefono ?? "—")</td>
                            <td>@p.FechaIngreso.ToString("dd-MM-yyyy")</td>
                            <td class="wrap">
                                @if (p.Documentos.Count == 0)
                                {
                                    <span style="color:var(--ink-faint);">Sin documentos</span>
                                }
                                else
                                {
                                    @foreach (var d in p.Documentos)
                                    {
                                        <a class="link-btn" href="@($"/reclutamiento/postulantes/documentos/{d.Id}")" target="_blank" style="margin-right:10px;">@SolicitudService.EtiquetaDocumento(d.Tipo)</a>
                                    }
                                }
                            </td>
                            <td>
                                @if (p.SeleccionadoPreseleccion)
                                {
                                    <span class="pill ok">Activado</span>
                                }
                                else
                                {
                                    <span class="pill pending">Pendiente</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (postulantes.Count == 0)
                    {
                        <tr><td colspan="8" style="color:var(--ink-faint);">Sin postulaciones recibidas todavía por el portal público.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="form-actions">
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <span>@mensaje</span>
            }
            <button class="btn-primary" disabled="@(seleccionados.Count == 0)" @onclick="ActivarAsync">Activar seleccionados para Preselección</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? SolicitudId { get; set; }

    private string usuarioId = string.Empty;
    private List<string> roles = [];

    private List<SolicitudService.SolicitudResumen> solicitudes = [];

    private SolicitudModel? solicitudActual;
    private string perfilNombre = string.Empty;
    private List<SolicitudService.PostulanteRecibido> postulantes = [];
    private HashSet<int> seleccionados = [];
    private string? mensaje;

    private bool todosSeleccionados => postulantes.Count > 0 && postulantes.All(p => p.SeleccionadoPreseleccion || seleccionados.Contains(p.PostulanteSolicitudId));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = UserManager.GetUserId(authState.User) ?? string.Empty;
        var perfil = await AccesoService.ObtenerPerfilUsuarioAsync(usuarioId);
        roles = perfil?.Roles ?? [];
    }

    // Mismo motivo que en Solicitud.razor: "/Reclutamiento/Preseleccion" y "/Reclutamiento/Preseleccion/{Id}"
    // resuelven al mismo componente — la carga que depende de SolicitudId vive en OnParametersSetAsync.
    protected override async Task OnParametersSetAsync()
    {
        if (SolicitudId is null)
        {
            solicitudes = await SolicitudService.ListarAsync(usuarioId, roles);
        }
        else
        {
            await CargarCandidatosAsync(SolicitudId.Value);
        }
    }

    private async Task CargarCandidatosAsync(int id)
    {
        solicitudActual = await SolicitudService.ObtenerAsync(id);
        if (solicitudActual is null)
        {
            NavigationManager.NavigateTo("/Reclutamiento/Preseleccion", forceLoad: true);
            return;
        }

        perfilNombre = await PerfilCargoService.ObtenerNombrePorVersionAsync(solicitudActual.PerfilCargoVersionId) ?? "—";
        postulantes = await SolicitudService.ListarPostulantesAsync(id);
        seleccionados.Clear();
    }

    // forceLoad: true — mismo motivo que AbrirSolicitud en Solicitud.razor.
    private void AbrirCandidatos(int id) => NavigationManager.NavigateTo($"/Reclutamiento/Preseleccion/{id}", forceLoad: true);

    private void ToggleUno(int postulanteSolicitudId, bool marcado)
    {
        if (marcado) seleccionados.Add(postulanteSolicitudId);
        else seleccionados.Remove(postulanteSolicitudId);
    }

    private void ToggleTodos(ChangeEventArgs e)
    {
        var marcar = (bool)e.Value!;
        seleccionados.Clear();
        if (marcar)
        {
            foreach (var p in postulantes.Where(p => !p.SeleccionadoPreseleccion))
            {
                seleccionados.Add(p.PostulanteSolicitudId);
            }
        }
    }

    private async Task ActivarAsync()
    {
        if (SolicitudId is null) return;
        var cantidad = seleccionados.Count;
        await SolicitudService.ActivarPostulantesAsync(SolicitudId.Value, seleccionados.ToList(), usuarioId);
        mensaje = $"{cantidad} postulante(s) activado(s).";
        await CargarCandidatosAsync(SolicitudId.Value);
    }
}

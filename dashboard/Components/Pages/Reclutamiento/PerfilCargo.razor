        {
            error = "Cliente y nombre del cargo son obligatorios.";
            return;
        }

        var funciones = funcionesEditables
            .Where(f => !string.IsNullOrWhiteSpace(f.Nombre))
            .Select(f => new PerfilCargoService.FuncionCategoriaInput(
                f.Nombre.Trim(),
                f.Tareas.Where(t => !string.IsNullOrWhiteSpace(t)).Select(t => t.Trim()).ToList()))
            .ToList();

        (string NombreArchivo, string RutaBlob)? documento = usoDocumentoIA && archivoAnalizadoNombre is not null && archivoAnalizadoRutaBlob is not null
            ? (archivoAnalizadoNombre, archivoAnalizadoRutaBlob)
            : null;

        var id = await PerfilCargoService.CrearAsync(
            new PerfilCargoModel
            {
                ClienteId = form.ClienteId,
                Nombre = form.Nombre.Trim(),
                Descripcion = string.IsNullOrWhiteSpace(form.Descripcion) ? null : form.Descripcion.Trim(),
                Requisitos = string.IsNullOrWhiteSpace(form.Requisitos) ? null : form.Requisitos.Trim(),
            },
            new PerfilCargoVersion
            {
                RentaFija = string.IsNullOrWhiteSpace(form.RentaFija) ? null : form.RentaFija.Trim(),
                RentaVariable = string.IsNullOrWhiteSpace(form.RentaVariable) ? null : form.RentaVariable.Trim(),
                Beneficios = string.IsNullOrWhiteSpace(form.Beneficios) ? null : form.Beneficios.Trim(),
                FechaVigencia = form.FechaVigencia,
                Area = string.IsNullOrWhiteSpace(form.Area) ? null : form.Area.Trim(),
                ReportaA = string.IsNullOrWhiteSpace(form.ReportaA) ? null : form.ReportaA.Trim(),
                ObjetivoCargo = string.IsNullOrWhiteSpace(form.ObjetivoCargo) ? null : form.ObjetivoCargo.Trim(),
                EducacionMinima = string.IsNullOrWhiteSpace(form.EducacionMinima) ? null : form.EducacionMinima.Trim(),
                AniosExperienciaMinimo = form.AniosExperienciaMinimo,
                ConocimientosTecnicos = string.IsNullOrWhiteSpace(form.ConocimientosTecnicos) ? null : form.ConocimientosTecnicos.Trim(),
                Habilidades = string.IsNullOrWhiteSpace(form.Habilidades) ? null : form.Habilidades.Trim(),
                CondicionesEspeciales = string.IsNullOrWhiteSpace(form.CondicionesEspeciales) ? null : form.CondicionesEspeciales.Trim(),
                OrigenDocumento = usoDocumentoIA ? "AnalizadoIA" : "Manual",
            },
            funciones, documento, usuarioId);

        mostrandoFormulario = false;
        perfiles = await PerfilCargoService.ListarAsync();

        if (creadoDesdeClienteId is null)
        {
            AbrirPerfil(id);
        }
    }


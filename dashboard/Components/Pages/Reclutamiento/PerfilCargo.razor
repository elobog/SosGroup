    private void AgregarCategoria() => funcionesEditables.Add(new FuncionCategoriaEdit());
    private void QuitarCategoria(FuncionCategoriaEdit categoria) => funcionesEditables.Remove(categoria);
    private void AgregarTarea(FuncionCategoriaEdit categoria) => categoria.Tareas.Add(string.Empty);
    private void QuitarTarea(FuncionCategoriaEdit categoria, int indice) => categoria.Tareas.RemoveAt(indice);

    private async Task CargarYAnalizar(InputFileChangeEventArgs e)
    {
        // Mismo control sirve para "Nuevo perfil de cargo" (Id es null, cliente viene de form.ClienteId)
        // y para "Agregar condición" sobre un perfil ya existente (Id no es null, cliente es perfilActual.ClienteId).
        int clienteId;
        int? perfilCargoIdParaBlob;
        if (Id is null)
        {
            if (form.ClienteId == 0)
            {
                errorAnalisis = "Seleccione el cliente antes de cargar el documento.";
                return;
            }
            clienteId = form.ClienteId;
            perfilCargoIdParaBlob = null;
        }
        else
        {
            if (perfilActual is null) return;
            clienteId = perfilActual.ClienteId;
            perfilCargoIdParaBlob = perfilActual.Id;
        }

        errorAnalisis = null;
        analizando = true;
        StateHasChanged();

        try
        {
            var archivo = e.File;
            using var memoria = new MemoryStream();
            await using (var stream = archivo.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024))
            {
                await stream.CopyToAsync(memoria);
            }
            memoria.Position = 0;

            var rutaBlob = await BlobStorageService.SubirPerfilCargoDocumentoAsync(perfilCargoIdParaBlob ?? 0, archivo.Name, memoria);
            var texto = PdfTextExtractor.ExtraerTexto(memoria.ToArray());

            var resultado = await PerfilCargoIAService.AnalizarAsync(texto, clienteId, null, usuarioId);

            AplicarResultadoAnalisis(resultado);

            archivoAnalizadoNombre = archivo.Name;
            archivoAnalizadoRutaBlob = rutaBlob;
            usoDocumentoIA = true;
        }
        catch (Exception ex)
        {
            errorAnalisis = $"No se pudo analizar el documento: {ex.Message}";
        }
        finally
        {
            analizando = false;
        }
    }

    private void AplicarResultadoAnalisis(PerfilCargoIAService.AnalisisResultado resultado)
    {
        if (Id is null)
        {
            form.Area = resultado.Area;
            form.ReportaA = resultado.ReportaA;
            form.ObjetivoCargo = resultado.ObjetivoCargo;
            form.EducacionMinima = resultado.EducacionMinima;
            form.AniosExperienciaMinimo = resultado.AniosExperienciaMinimo;
            form.ConocimientosTecnicos = resultado.ConocimientosTecnicos;
            form.Habilidades = resultado.Habilidades;
            form.CondicionesEspeciales = resultado.CondicionesEspeciales;
            if (!string.IsNullOrWhiteSpace(resultado.RentaFija)) form.RentaFija = resultado.RentaFija;
            if (!string.IsNullOrWhiteSpace(resultado.RentaVariable)) form.RentaVariable = resultado.RentaVariable;
            if (!string.IsNullOrWhiteSpace(resultado.Beneficios)) form.Beneficios = resultado.Beneficios;
        }
        else
        {
            formCondicion.Area = resultado.Area;
            formCondicion.ReportaA = resultado.ReportaA;
            formCondicion.ObjetivoCargo = resultado.ObjetivoCargo;
            formCondicion.EducacionMinima = resultado.EducacionMinima;
            formCondicion.AniosExperienciaMinimo = resultado.AniosExperienciaMinimo;
            formCondicion.ConocimientosTecnicos = resultado.ConocimientosTecnicos;
            formCondicion.Habilidades = resultado.Habilidades;
            formCondicion.CondicionesEspeciales = resultado.CondicionesEspeciales;
            if (!string.IsNullOrWhiteSpace(resultado.RentaFija)) formCondicion.RentaFija = resultado.RentaFija;
            if (!string.IsNullOrWhiteSpace(resultado.RentaVariable)) formCondicion.RentaVariable = resultado.RentaVariable;
            if (!string.IsNullOrWhiteSpace(resultado.Beneficios)) formCondicion.Beneficios = resultado.Beneficios;
        }

        funcionesEditables = resultado.Funciones
            .Select(f => new FuncionCategoriaEdit { Nombre = f.Nombre, Tareas = [.. f.Tareas] })
            .ToList();
    }

    private async Task GuardarCondicion()
    {
        if (Id is null) return;

        var funciones = funcionesEditables
            .Where(f => !string.IsNullOrWhiteSpace(f.Nombre))
            .Select(f => new PerfilCargoService.FuncionCategoriaInput(
                f.Nombre.Trim(),
                f.Tareas.Where(t => !string.IsNullOrWhiteSpace(t)).Select(t => t.Trim()).ToList()))
            .ToList();

        (string NombreArchivo, string RutaBlob)? documento = usoDocumentoIA && archivoAnalizadoNombre is not null && archivoAnalizadoRutaBlob is not null
            ? (archivoAnalizadoNombre, archivoAnalizadoRutaBlob)
            : null;

        await PerfilCargoService.AgregarCondicionAsync(Id.Value, new PerfilCargoVersion
        {
            RentaFija = string.IsNullOrWhiteSpace(formCondicion.RentaFija) ? null : formCondicion.RentaFija.Trim(),
            RentaVariable = string.IsNullOrWhiteSpace(formCondicion.RentaVariable) ? null : formCondicion.RentaVariable.Trim(),
            Beneficios = string.IsNullOrWhiteSpace(formCondicion.Beneficios) ? null : formCondicion.Beneficios.Trim(),
            FechaVigencia = formCondicion.FechaVigencia,
            Area = string.IsNullOrWhiteSpace(formCondicion.Area) ? null : formCondicion.Area.Trim(),
            ReportaA = string.IsNullOrWhiteSpace(formCondicion.ReportaA) ? null : formCondicion.ReportaA.Trim(),
            ObjetivoCargo = string.IsNullOrWhiteSpace(formCondicion.ObjetivoCargo) ? null : formCondicion.ObjetivoCargo.Trim(),
            EducacionMinima = string.IsNullOrWhiteSpace(formCondicion.EducacionMinima) ? null : formCondicion.EducacionMinima.Trim(),
            AniosExperienciaMinimo = formCondicion.AniosExperienciaMinimo,
            ConocimientosTecnicos = string.IsNullOrWhiteSpace(formCondicion.ConocimientosTecnicos) ? null : formCondicion.ConocimientosTecnicos.Trim(),
            Habilidades = string.IsNullOrWhiteSpace(formCondicion.Habilidades) ? null : formCondicion.Habilidades.Trim(),
            CondicionesEspeciales = string.IsNullOrWhiteSpace(formCondicion.CondicionesEspeciales) ? null : formCondicion.CondicionesEspeciales.Trim(),
            OrigenDocumento = usoDocumentoIA ? "AnalizadoIA" : "Manual",
        }, funciones, documento, usuarioId);

        mostrandoFormCondicion = false;
        await CargarFichaAsync(Id.Value);
    }

    private async Task Aprobar(int versionId, string rol)
    {
        await PerfilCargoService.AprobarVersionAsync(versionId, rol, usuarioId);
        if (Id is not null) await CargarFichaAsync(Id.Value);
    }

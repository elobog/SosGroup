@using Microsoft.AspNetCore.Identity
@using dashboard.Data

@inject SignInManager<ApplicationUser> SignInManager

<div class="manage-nav">
    <NavLink class="manage-nav-item" href="Account/Manage" Match="NavLinkMatch.All">Perfil</NavLink>
    <NavLink class="manage-nav-item" href="Account/Manage/Email">Correo</NavLink>
    <NavLink class="manage-nav-item" href="Account/Manage/ChangePassword">Contraseña</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="manage-nav-item" href="Account/Manage/ExternalLogins">Accesos externos</NavLink>
    }
    <NavLink class="manage-nav-item" href="Account/Manage/TwoFactorAuthentication">Verificación en dos pasos</NavLink>
    <NavLink class="manage-nav-item" href="Account/Manage/Passkeys">Passkeys</NavLink>
    <NavLink class="manage-nav-item" href="Account/Manage/PersonalData">Datos personales</NavLink>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}

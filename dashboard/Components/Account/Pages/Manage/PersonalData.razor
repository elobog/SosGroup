@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using dashboard.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales | SOS Group</PageTitle>

<StatusMessage />

<div class="panel">
    <div class="panel-head"><h3>Datos personales</h3></div>
    <div class="form-grid">
        <p>Tu cuenta contiene datos personales que nos entregaste. Desde acá puedes descargarlos o eliminarlos.</p>
        <p>
            <strong>Eliminar estos datos borra tu cuenta para siempre — no se puede deshacer.</strong>
        </p>
    </div>
    <div class="form-actions" style="justify-content:flex-start;">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn-ghost" type="submit">Descargar</button>
        </form>
        <a href="Account/Manage/DeletePersonalData" class="btn-ghost" style="color:var(--red)">Eliminar</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}

@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using dashboard.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verificación en dos pasos | SOS Group</PageTitle>

<StatusMessage />
<div class="panel">
    <div class="panel-head"><h3>Verificación en dos pasos (2FA)</h3></div>
    <div class="form-grid">
    @if (canTrack)
    {
        if (is2faEnabled)
        {
            if (recoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>No te quedan códigos de recuperación.</strong>
                    <p>Debes <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo set de códigos</a> antes de poder ingresar con un código de recuperación.</p>
                </div>
            }
            else if (recoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Te queda 1 código de recuperación.</strong>
                    <p>Puedes <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo set de códigos</a>.</p>
                </div>
            }
            else if (recoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Te quedan @recoveryCodesLeft códigos de recuperación.</strong>
                    <p>Te conviene <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo set de códigos</a>.</p>
                </div>
            }

            <div class="form-actions" style="justify-content:flex-start;">
                @if (isMachineRemembered)
                {
                    <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-ghost">Olvidar este navegador</button>
                    </form>
                }

                <a href="Account/Manage/Disable2fa" class="btn-ghost">Desactivar 2FA</a>
                <a href="Account/Manage/GenerateRecoveryCodes" class="btn-ghost">Regenerar códigos de recuperación</a>
            </div>
        }

        <div>
            <h4 style="font-size:15px; margin-bottom:10px;">App autenticadora</h4>
            <div class="form-actions" style="justify-content:flex-start; padding:0;">
                @if (!hasAuthenticator)
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn-primary">Agregar app autenticadora</a>
                }
                else
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn-ghost">Configurar app autenticadora</a>
                    <a href="Account/Manage/ResetAuthenticator" class="btn-ghost">Reiniciar app autenticadora</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>No se aceptó la política de privacidad y cookies.</strong>
            <p>Debes aceptar la política antes de poder activar la verificación en dos pasos.</p>
        </div>
    }
    </div>
</div>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Este navegador quedó olvidado. La próxima vez que ingreses desde acá te vamos a pedir tu código 2fa.",
            HttpContext);
    }
}

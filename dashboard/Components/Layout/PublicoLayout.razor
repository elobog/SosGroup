@inherits LayoutComponentBase

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="publico-shell">
    <header class="publico-header">
        <a href="/postulaciones" class="publico-brand">
            <img src="images/logo-sos-group.png" alt="SOS Group" />
        </a>
        <span class="publico-header-tag">Trabaja con nosotros</span>
        <span class="publico-header-spacer"></span>
        <a href="/postulaciones/mi-cuenta" class="publico-header-link">¿Ya postulaste? Accede a tu cuenta</a>
    </header>
    <main class="publico-main">
        @Body
    </main>
    <footer class="publico-footer">© 2026 SOS Group — Selección · Outsourcing · Servicios Transitorios</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@inherits LayoutComponentBase

<div class="publico-shell">
    <header class="publico-header">
        <a href="/postulaciones" class="publico-brand">
            <img src="images/logo-sos-group.png" alt="SOS Group" />
            <span>Trabaja con nosotros</span>
        </a>
    </header>
    <main class="publico-main">
        @Body
    </main>
    <footer class="publico-footer">© 2026 SOS Group — Selección · Outsourcing · Servicios Transitorios</footer>
